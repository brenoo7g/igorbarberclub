{
  "extends": "expo/tsconfig.base",
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "test-results", ".expo", "android", "ios"],
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "react"]
  }
}
