{
  "name": "igor-barber-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:test-access": "concurrently -k -n API,WEB -c blue,magenta \"node server/index.js --guest-test-mode\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && npm run check:schedule && vite build",
    "check:schedule": "tsc --allowJs --checkJs --noEmit --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck server/schedule.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write api src server tests docs README.md *.json *.ts *.js index.html",
    "format:check": "prettier --check api src server tests docs README.md *.json *.ts *.js index.html"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.5",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "sharp": "^0.35.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
