PORT=3001
APP_URL=http://localhost:5173
# Node 24+. Leave empty to use the local SQLite database.
DATABASE_URL=
# On Vercel, a managed PostgreSQL connection is mandatory. POSTGRES_URL is also accepted.
SQLITE_PATH=./data/barber.db
# Required in production: at least 32 random characters.
JWT_SECRET=
# Demo data is enabled only outside production, by default.
DEMO_MODE=true
ADMIN_EMAIL=admin@igorbarberclub.com.br
ADMIN_PASSWORD=
# Vercel Production: APP_URL=https://igorbarberclub.vercel.app, DEMO_MODE=false.
# Set JWT_SECRET (32+ characters) and your own ADMIN_PASSWORD (12+ characters).
# Business hours are in America/Sao_Paulo, Monday–Saturday.
OPEN_HOUR=9
CLOSE_HOUR=19
# Notification providers are optional. Nothing is sent without credentials.
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp template: variables 1=name, 2=event, 3=date/time, 4=account URL.
TWILIO_CONTENT_SID=
