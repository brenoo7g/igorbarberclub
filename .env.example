PORT=3001
APP_URL=http://localhost:5173
# Node 24+. Leave empty to use the local SQLite database.
DATABASE_URL=
# On Vercel, a managed PostgreSQL connection is mandatory. POSTGRES_URL is also accepted.
SQLITE_PATH=./data/barber.db
# Required for persistent databases, including local development: 32+ random characters.
# Keep this value stable across API restarts. Never commit the actual secret.
# Only isolated, disposable test databases may use an ephemeral signing key.
JWT_SECRET=
# Demo data is enabled only outside production, by default.
DEMO_MODE=true
ADMIN_EMAIL=admin@igorbarberclub.com.br
ADMIN_PASSWORD=
# Vercel Production: APP_URL=https://igorbarberclub.vercel.app, DEMO_MODE=false.
# Set JWT_SECRET (32+ characters) and your own ADMIN_PASSWORD (12+ characters).
# Business hours are in America/Sao_Paulo, Monday–Saturday.
OPEN_HOUR=9
CLOSE_HOUR=19
# Nothing is sent by default, even when credentials exist. See docs/RESEND.md.
EMAIL_DELIVERY_MODE=disabled
# New random value per explicitly authorized activation; never stamp old queued rows.
EMAIL_DELIVERY_SCOPE=
# Required for test and for every non-production environment.
EMAIL_TEST_DATABASE=
EMAIL_TEST_ALLOWLIST=
RESEND_API_KEY=
# Verified sending domain reported by owner: Gradefy <notificacoes@gradefyapp.com.br>
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp template: variables 1=name, 2=event, 3=date/time, 4=account URL.
TWILIO_CONTENT_SID=
# Meu Site: optional private object storage, exclusively on the backend.
# No uploads are enabled without these values. Never use VITE_ for credentials.
SITE_STORAGE_PROVIDER=
SITE_STORAGE_URL=
SITE_STORAGE_SERVICE_KEY=
SITE_STORAGE_BUCKET=
